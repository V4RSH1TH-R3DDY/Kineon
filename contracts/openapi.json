  "components": {
    "schemas": {
      "Baseline": {
        "properties": {
          "patient_id": {
            "type": "string",
            "title": "Patient Id"
          },
          "median_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Median Score"
          },
          "typical_hz": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Typical Hz"
          },
          "windows_seen": {
            "type": "integer",
            "title": "Windows Seen"
          }
        },
        "type": "object",
        "required": [
          "patient_id",
          "median_score",
          "typical_hz",
          "windows_seen"
        ],
        "title": "Baseline"
      },
      "CalmDecision": {
        "properties": {
          "trigger": {
            "type": "boolean",
            "title": "Trigger"
          },
          "episode_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Episode Id"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "tips": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tips",
            "default": []
          },
          "suggest_contact_clinician": {
            "type": "boolean",
            "title": "Suggest Contact Clinician",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "trigger",
          "reason"
        ],
        "title": "CalmDecision"
      },
      "CalmEvaluateRequest": {
        "properties": {
          "recent_score": {
            "type": "number",
            "title": "Recent Score"
          },
          "baseline_score": {
            "type": "number",
            "title": "Baseline Score"
          },
          "heart_rate_bpm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heart Rate Bpm"
          },
          "baseline_heart_rate_bpm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Heart Rate Bpm"
          },
          "manual": {
            "type": "boolean",
            "title": "Manual",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "recent_score",
          "baseline_score"
        ],
        "title": "CalmEvaluateRequest"
      },
      "CalmOutcome": {
        "properties": {
          "episode_id": {
            "type": "string",
            "title": "Episode Id"
          },
          "tremor_settled": {
            "type": "boolean",
            "title": "Tremor Settled"
          },
          "heart_rate_settled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heart Rate Settled"
          }
        },
        "type": "object",
        "required": [
          "episode_id",
          "tremor_settled"
        ],
        "title": "CalmOutcome"
      },
      "Consent": {
        "properties": {
          "consent_id": {
            "type": "string",
            "title": "Consent Id"
          }
        },
        "type": "object",
        "required": [
          "consent_id"
        ],
        "title": "Consent"
      },
      "DoseEvent": {
        "properties": {
          "taken_at": {
            "type": "string",
            "format": "date-time",
            "title": "Taken At"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "tags": {
            "items": {
              "type": "string",
              "enum": [
                "caffeine",
                "stress",
                "sleep_poor"
              ]
            },
            "type": "array",
            "title": "Tags",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "taken_at",
          "label"
        ],
        "title": "DoseEvent"
      },
      "ExportRequest": {
        "properties": {
          "consent_id": {
            "type": "string",
            "title": "Consent Id"
          }
        },
        "type": "object",
        "required": [
          "consent_id"
        ],
        "title": "ExportRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MotionWindow": {
        "properties": {
          "patient_id": {
            "type": "string",
            "title": "Patient Id"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "sample_rate_hz": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Sample Rate Hz"
          },
          "accel": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 3,
              "minItems": 3
            },
            "type": "array",
            "title": "Accel"
          },
          "gyro": {
            "anyOf": [
              {
                "items": {
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array",
                  "maxItems": 3,
                  "minItems": 3
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gyro"
          },
          "heart_rate_bpm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heart Rate Bpm"
          },
          "source": {
            "type": "string",
            "enum": [
              "watch",
              "phone"
            ],
            "title": "Source",
            "default": "watch"
          }
        },
        "type": "object",
        "required": [
          "patient_id",
          "started_at",
          "sample_rate_hz",
          "accel"
        ],
        "title": "MotionWindow"
      },
      "Report": {
        "properties": {
          "patient_id": {
            "type": "string",
            "title": "Patient Id"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "default": "Tracking report, not a diagnosis."
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "hi",
              "kn"
            ],
            "title": "Lang",
            "default": "en"
          }
        },
        "type": "object",
        "required": [
          "patient_id",
          "summary"
        ],
        "title": "Report"
      },
      "ReviewItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "patient_id": {
            "type": "string",
            "title": "Patient Id"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          },
          "result": {
            "$ref": "#/components/schemas/ScoreResult"
          }
        },
        "type": "object",
        "required": [
          "id",
          "patient_id",
          "at",
          "result"
        ],
        "title": "ReviewItem"
      },
      "ReviewVerdict": {
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "tremor",
              "not_tremor",
              "unsure"
            ],
            "title": "Label"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "label"
        ],
        "title": "ReviewVerdict"
      },
      "ScoreResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "insufficient_data"
            ],
            "title": "Status"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "activity": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "resting",
                  "walking",
                  "eating",
                  "writing",
                  "brushing",
                  "unknown"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Activity"
          },
          "tremor_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tremor Score"
          },
          "band_low": {
            "anyOf": [
              {
